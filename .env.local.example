# Set to "true" to preview the site with local placeholder content/images
# (see public/demo/) instead of live Sanity data — no CMS project required.
# Set to "false" (or remove) once you connect a real Sanity project.
NEXT_PUBLIC_DEMO_MODE=false

# Sanity project configuration
# Find/create your project at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional: read token, only needed if you query draft/private content from the server
SANITY_API_READ_TOKEN=

# Write token used ONLY by `npm run seed` to create example content.
# Create one at https://www.sanity.io/manage under API > Tokens (Editor permission is enough).
# Never expose this in NEXT_PUBLIC_* variables or commit it.
SANITY_API_WRITE_TOKEN=

# Secret used to authenticate Sanity webhook requests that trigger on-demand revalidation
SANITY_REVALIDATE_SECRET=change-me

# Base URL of the deployed site, used for metadata, sitemap, and OG images
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: contact form email delivery via Resend (https://resend.com)
# Leave unset to have submissions logged to the server console instead
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
